# Copia este archivo como .env (en la raíz del repo) y pon tus llaves. .env está en .gitignore: nunca se sube.
# También sirven como variables de entorno del sistema.

# Obligatoria: transcripción con Whisper de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opcional: ElevenLabs Scribe (node scripts/transcribir.mjs … --scribe), separa hablantes (https://elevenlabs.io)
ELEVENLABS_API_KEY=
